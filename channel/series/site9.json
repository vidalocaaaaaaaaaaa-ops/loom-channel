      "end_card": {
        "title": "SITE NINE",
        "subtitle": "Log 03: The Eleventh Valve",
        "hold": 2.4
      },
      "hook": "Log 02. The pipeline moves four metres a night, and it is getting faster.",
      "social": {
        "body": "The survey team measured the same pipeline twice a night for a week. It was never in the same place."
      },
      "script": [
        {
          "id": "l1",
          "text": "They measured the same section twice a night for a week.",
          "viz": "statement",
          "kicker": "LOG 02 \u00b7 ANOMALY",
          "transition": "cut"
        },
        {
          "id": "l2",
          "text": "The pipeline was never in the same place twice.",
          "viz": "statement",
          "kicker": "THE READINGS"
        },
        {
          "id": "l3",
          "text": "By the seventh night it had moved twenty eight metres, always in the same direction.",
          "viz": "line",
          "kicker": "DRIFT, NIGHT BY NIGHT",
          "points": [
            0,
            3,
            5,
            9,
            14,
            21,
            28
          ],
          "labels": [
            "N1",
            "N2",
            "N3",
            "N4",
            "N5",
            "N6",
            "N7"
          ],
          "source": "fiction \u2014 invented for this story"
        },
        {
          "id": "l4",
          "text": "Four metres a night on average. Which is not how steel behaves.",
          "viz": "stat",
          "value": 4,
          "unit": " m/night",
          "label": "average movement of a buried pipeline",
          "kicker": "THE NUMBER",
          "source": "fiction \u2014 invented for this story"
        },
        {
          "id": "l5",
          "text": "The direction it moved was toward the only room on the site still locked.",
          "viz": "compare",
          "kicker": "DIRECTION",
          "left": {
            "value": "28 m",
            "label": "distance travelled in seven nights"
          },
          "right": {
            "value": "1",
            "label": "locked room on the whole site"
          }
        },
        {
          "id": "l6",
          "text": "The team stopped measuring. They kept writing the same number every night.",
          "viz": "quote",
          "quote": "Same as yesterday. Four metres.",
          "attribution": "log 02, night seven",
          "transition": "dip"
        }
      ]
    },
    {
