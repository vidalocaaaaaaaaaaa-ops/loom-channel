        "hold": 2.4
      },
      "hook": "Log 01 of a survey that does not match the contract.",
      "social": {
        "body": "The crew surveyed four kilometres. The contract says eleven. This is a fiction series built from invented survey logs."
      },
      "script": [
        {
          "id": "l1",
          "text": "Site nine was surveyed in April. The crew logged four kilometres.",
          "viz": "statement",
          "kicker": "LOG 01 \u00b7 THE SURVEY",
          "transition": "cut"
        },
        {
          "id": "l2",
          "text": "The contract said eleven kilometres. Nobody could find the other seven.",
          "viz": "statement",
          "kicker": "THE CONTRACT"
        },
        {
          "id": "l3",
          "text": "Seven kilometres of pipeline are logged as built and never walked.",
          "viz": "stat",
          "value": 7,
          "unit": " km",
          "label": "logged as built, never surveyed",
          "kicker": "THE GAP",
          "source": "fiction \u2014 invented for this story"
        },
        {
          "id": "l4",
          "text": "The crew's own paperwork does not agree with the crew.",
          "viz": "bars",
          "kicker": "LOG VERSUS GROUND",
          "rows": [
            {
              "label": "Logged as built",
              "value": 11,
              "unit": " km",
              "accent": true
            },
            {
              "label": "Found on the ground",
              "value": 4,
              "unit": " km"
            }
          ],
          "source": "fiction \u2014 invented for this story"
        },
        {
          "id": "l5",
          "text": "Then the file closes for twenty nine years and reopens without a reason.",
          "viz": "timeline",
          "kicker": "THE FILE",
          "items": [
            {
              "date": "APR 1996",
              "text": "survey run"
            },
            {
              "date": "MAY 1996",
              "text": "sealed"
            },
            {
              "date": "JUN 1996",
              "text": "decommissioned"
            },
            {
              "date": "2025",
              "text": "reopened"
            }
          ]
        },
        {
          "id": "l6",
          "text": "The last page is a note in the surveyor's hand: do not walk the seventh.",
          "viz": "quote",
          "quote": "Do not walk the seventh.",
          "attribution": "surveyor's note, page 44",
          "transition": "dip"
        }
      ]
    },
    {
      "part": 2,
