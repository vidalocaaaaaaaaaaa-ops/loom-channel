{
 "voice": "am_onyx",
 "speed": 0.92,
 "sr": 48000,
 "duration": 45.069,
 "speech_seconds": 35.66,
 "lines": [
  {
   "id": "l1",
   "text": "The page listed two names for tonight. He had written only one.",
   "start": 2.95,
   "end": 6.637333333333333,
   "words": 12,
   "conf": 0.727
  },
  {
   "id": "l2",
   "text": "Room four oh two had no lock. The handle turned before he touched it.",
   "start": 7.257333333333333,
   "end": 11.08,
   "words": 14,
   "conf": 0.769
  },
  {
   "id": "l3",
   "text": "He stepped inside and closed the door, the way you do when someone is waiting.",
   "start": 11.7,
   "end": 15.853333333333332,
   "words": 15,
   "conf": 0.786
  },
  {
   "id": "l4",
   "text": "A man stood with his back to the door, in a coat thirty years out of date.",
   "start": 16.473333333333333,
   "end": 20.210666666666665,
   "words": 17,
   "conf": 0.938
  },
  {
   "id": "l5",
   "text": "He said, you're in my room. The man said his name without turning around.",
   "start": 20.830666666666666,
   "end": 24.706666666666667,
   "words": 14,
   "conf": 0.692
  },
  {
   "id": "l6",
   "text": "On the nightstand, tonight's entry was open. The second name was already written.",
   "start": 25.326666666666664,
   "end": 29.78933333333333,
   "words": 13,
   "conf": 0.833
  },
  {
   "id": "l7",
   "text": "The ink was still wet. The handwriting was his, from an angle he never wrote from.",
   "start": 30.40933333333333,
   "end": 34.839999999999996,
   "words": 16,
   "conf": 0.867
  },
  {
   "id": "l8",
   "text": "Then the guest stood, and every lamp in the corridor went out at once.",
   "start": 35.459999999999994,
   "end": 39.029999999999994,
   "words": 14,
   "conf": 0.769
  },
  {
   "id": "l9",
   "text": "He signed the second name. Someone in the corridor said: see you at checkout.",
   "start": 39.64999999999999,
   "end": 43.56866666666666,
   "words": 14,
   "conf": 0.846
  }
 ],
