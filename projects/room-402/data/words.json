 "lines": [
  {
   "id": "l1",
   "text": "The phone rang at two fourteen in the morning.",
   "start": 3.05,
   "end": 5.756,
   "words": 9,
   "conf": 0.75
  },
  {
   "id": "l2",
   "text": "The call came from room four oh two.",
   "start": 6.3759999999999994,
   "end": 8.705333333333332,
   "words": 8,
   "conf": 0.857
  },
  {
   "id": "l3",
   "text": "Room four oh two has been sealed since the fire. Nineteen ninety six.",
   "start": 9.325333333333333,
   "end": 13.578,
   "words": 13,
   "conf": 0.833
  },
  {
   "id": "l4",
   "text": "No key. No guest. No name in the register.",
   "start": 14.198,
   "end": 17.007333333333335,
   "words": 9,
   "conf": 0.5
  },
  {
   "id": "l5",
   "text": "The night clerk answered anyway.",
   "start": 17.627333333333333,
   "end": 19.668666666666667,
   "words": 5,
   "conf": 0.75
  },
  {
   "id": "l6",
   "text": "The voice was calm. It said, I'm in the bathroom, and I can't find the door.",
   "start": 20.288666666666664,
   "end": 24.409999999999997,
   "words": 16,
   "conf": 0.8
  },
  {
   "id": "l7",
   "text": "He walked the fourth floor alone. Every door was locked.",
   "start": 25.029999999999998,
   "end": 28.127333333333333,
   "words": 10,
   "conf": 0.778
  },
  {
   "id": "l8",
   "text": "Room four oh two was warm. The tap was running. The window was painted shut.",
   "start": 28.74733333333333,
   "end": 32.86866666666666,
   "words": 15,
   "conf": 0.714
  },
  {
   "id": "l9",
   "text": "At sunrise they traced the call. To the phone on his desk. The one he was still holding.",
   "start": 33.48866666666666,
   "end": 38.15733333333333,
   "words": 18,
   "conf": 0.706
  }
 ],
