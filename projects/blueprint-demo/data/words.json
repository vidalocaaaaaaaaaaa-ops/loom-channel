 "lines": [
  {
   "id": "l1",
   "text": "Eight hours of sleep used to be a guess.",
   "start": 0.45,
   "end": 2.42,
   "words": 9,
   "conf": 0.75
  },
  {
   "id": "l2",
   "text": "Then a lab started measuring what six hours a night actually costs.",
   "start": 2.7600000000000002,
   "end": 6.746,
   "words": 12,
   "conf": 0.727
  },
  {
   "id": "l3",
   "text": "After two weeks, reaction time had fallen by thirty two percent.",
   "start": 7.086,
   "end": 10.773333333333333,
   "words": 11,
   "conf": 1.0
  },
  {
   "id": "l4",
   "text": "But almost nobody in the study noticed it happening.",
   "start": 11.113333333333333,
   "end": 13.851333333333333,
   "words": 9,
   "conf": 0.75
  },
  {
   "id": "l5",
   "text": "Sleep debt does not feel like debt. It feels like normal.",
   "start": 14.191333333333333,
   "end": 17.345333333333333,
   "words": 11,
   "conf": 1.0
  }
 ],
