 "lines": [
  {
   "id": "l1",
   "text": "By three in the morning, the register was the only thing left to check.",
   "start": 2.95,
   "end": 6.495333333333333,
   "words": 14,
   "conf": 0.846
  },
  {
   "id": "l2",
   "text": "Room four oh two was sealed the night of the fire. Everyone signed off on it.",
   "start": 7.115333333333333,
   "end": 11.354,
   "words": 16,
   "conf": 0.867
  },
  {
   "id": "l3",
   "text": "The last entry in the book was dated fourteenth October, nineteen ninety six.",
   "start": 11.974,
   "end": 16.394,
   "words": 13,
   "conf": 0.833
  },
  {
   "id": "l4",
   "text": "Under the date, a signature. The ink had not dried.",
   "start": 17.014,
   "end": 20.157333333333334,
   "words": 10,
   "conf": 0.778
  },
  {
   "id": "l5",
   "text": "He knew the handwriting. It was his own.",
   "start": 20.77733333333333,
   "end": 22.967999999999996,
   "words": 8,
   "conf": 0.857
  },
  {
   "id": "l6",
   "text": "The entry was logged at two fourteen in the morning. The same minute the phone rang.",
   "start": 23.587999999999997,
   "end": 28.338666666666665,
   "words": 16,
   "conf": 0.8
  },
  {
   "id": "l7",
   "text": "He turned the page. Tonight's date was already written. In his hand.",
   "start": 28.958666666666666,
   "end": 32.55733333333333,
   "words": 12,
   "conf": 0.909
  },
  {
   "id": "l8",
   "text": "Then, one by one, the corridor lamps began to go out.",
   "start": 33.17733333333333,
   "end": 36.21066666666666,
   "words": 11,
   "conf": 0.6
  },
  {
   "id": "l9",
   "text": "The register lists two names for tonight. His. And the one already inside room four oh two.",
   "start": 36.830666666666666,
   "end": 42.135999999999996,
   "words": 17,
   "conf": 0.688
  }
 ],
